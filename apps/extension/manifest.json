{
  "manifest_version": 3,
  "name": "Tallywork",
  "description": "Shares the website in your active tab with the Tallywork desktop app, only while your timer is running.",
  "version": "0.1.0",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tallywork"
  },
  "incognito": "not_allowed"
}
