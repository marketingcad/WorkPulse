{
  "name": "tallywork",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@tallywork/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @tallywork/db generate",
    "db:migrate": "pnpm --filter @tallywork/db migrate",
    "db:seed": "pnpm --filter @tallywork/db seed"
  },
  "devDependencies": {
    "turbo": "^2.11.3",
    "typescript": "5.9.3",
    "@types/node": "^24.13.6",
    "vitest": "^5.0.1",
    "tsx": "^4.23.15"
  }
}
